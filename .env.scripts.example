# ================================================
# CONFIGURAÇÕES DOS SCRIPTS POWERSHELL (EXEMPLO)
# Copie este arquivo para .env.scripts e configure com seus valores
# ================================================

# Diretório de trabalho dos scripts
SCRIPTS_WORKING_DIR=C:\caminho\para\seu\projeto\n8n

# Caminho para o Docker Desktop
DOCKER_DESKTOP_PATH=C:\Program Files\Docker\Docker\Docker Desktop.exe

# API Key da Evolution API (para scripts de health check)
EVOLUTION_API_KEY=SUA_API_KEY_AQUI

# URLs dos serviços locais
LOCAL_N8N_URL=http://localhost:5678
LOCAL_EVOLUTION_URL=http://localhost:8080
LOCAL_SCRAPER_URL=http://localhost:5679
LOCAL_STUDIO_URL=http://localhost:3000
LOCAL_KONG_URL=http://localhost:8888

# URLs externas (públicas) - Altere para seus domínios
EXTERNAL_N8N_URL=https://seu-n8n.seu-dominio.com
EXTERNAL_EVOLUTION_URL=https://sua-evolution.seu-dominio.com
