# ================================================
# CONFIGURAÇÕES POSTGRESQL (N8N)
# ================================================
POSTGRES_DB=n8n
POSTGRES_USER=n8n_user
POSTGRES_PASSWORD=SUA_SENHA_AQUI

# ================================================
# CONFIGURAÇÕES CLOUDFLARE TUNNEL
# ================================================
CLOUDFLARE_TUNNEL_TOKEN=SUA_CHAVE_AQUI

# ================================================
# CONFIGURAÇÕES N8N
# ================================================
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n_user
DB_POSTGRESDB_PASSWORD=SUA_SENHA_AQUI
N8N_ENCRYPTION_KEY=SUA_CHAVE_DE_ENCRYPTACAO_AQUI

# Habilita todos os nós (incluindo Execute Command)
NODES_EXCLUDE=[]

# Configurar para usar o domínio público
N8N_HOST=n8n.bearcavelabs.com.br
N8N_PORT=5678
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.bearcavelabs.com.br/

# ================================================
# CONFIGURAÇÕES EVOLUTION API
# ================================================
SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=https://evolution.bearcavelabs.com.br
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE
CORS_CREDENTIALS=true
LOG_LEVEL=ERROR,WARN,INFO
LOG_COLOR=true
LOG_BAILEYS=error
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://n8n_user:SUA_SENHA_AQUI@postgres:5432/n8n?schema=evolution_api
DATABASE_CONNECTION_CLIENT_NAME=evolution_api
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
CONFIG_SESSION_PHONE_CLIENT=Whastapp Business API
CONFIG_SESSION_PHONE_NAME=Chrome
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379
AUTHENTICATION_API_KEY=SUA_API_KEY_AQUI
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true
WEBHOOK_GLOBAL_ENABLED=false
WEBHOOK_GLOBAL_URL=https://n8n.bearcavelabs.com.br/webhook/b27c5178-fdbc-4e50-96a6-566584c1911a
WEBSOCKET_ENABLED=true
RABBITMQ_ENABLED=true
RABBITMQ_URI=amqp://user:SUA_SENHA_AQUI@rabbitmq:5672
CHATWOOT_ENABLED=true
AUTHENTICATION_TYPE=apikey
TYPEBOT_ENABLED=true
TYPEBOT_API_VERSION=latest
TYPEBOT_API_KEY=SUA_API_KEY_AQUI
TYPEBOT_URL=https://bot.bearcavelabs.com.br

# ================================================
# CONFIGURAÇÕES RABBITMQ
# ================================================
RABBITMQ_DEFAULT_USER=user
RABBITMQ_DEFAULT_PASS=SUA_SENHA_AQUI

# ================================================
# OUTRAS CONFIGURAÇÕES
# ================================================
RLIMIT_NOFILE=1048576

# ================================================
# CONFIGURAÇÕES TYPEBOT
# ================================================
# Chave de criptografia para dados sensíveis (32 caracteres)
ENCRYPTION_SECRET=SUA_CHAVE_DE_ENCRYPTACAO_AQUI

# URL do banco de dados (usando banco de dados separado typebot)
DATABASE_URL=postgresql://postgres:SUA_SENHA_AQUI@postgres:5432/typebot

# URLs públicas do Typebot
NEXTAUTH_URL=https://typebot.bearcavelabs.com.br
NEXT_PUBLIC_VIEWER_URL=https://bot.bearcavelabs.com.br

# NextAuth Secret (obrigatório para sessões)
NEXTAUTH_SECRET=SEU_NEXTAUTH_SECRET_AQUI

# Email do administrador (primeiro login)
ADMIN_EMAIL=admin@bearcavelabs.com.br

# Desabilitar telemetria (remover NEXT_PUBLIC_POSTHOG_KEY vazio)
DISABLE_TELEMETRY=true

# Autenticação por Email (desabilitado - precisa SMTP)
# NEXT_PUBLIC_EMAIL_AUTH_ENABLED=true
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# Autenticação GitHub OAuth (SUBSTITUA PELOS SEUS VALORES)
GITHUB_CLIENT_ID=SEU_GITHUB_CLIENT_ID_AQUI
GITHUB_CLIENT_SECRET=SEU_GITHUB_CLIENT_SECRET_AQUI

# Node options
NODE_OPTIONS=--no-node-snapshot
